Use DataDict.pkg

Open liga
Open equipo

Class cligaDataDictionary is a DataDictionary

    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to liga.File_Number

        Set Add_Client_File to equipo.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        // --- Clave primaria protegida ---
        Set Key_Field_State Field liga.ID to True
        Set Protect_Key_State to True

        // --- Campos NOT NULL en la BD: obligatorios ---
        // (Equipos no: una liga nueva tiene 0 equipos y DataFlex trata el 0 como vacio)
        Set Field_Option Field liga.Nombre DD_REQUIRED to True
        Set Field_Option Field liga.Pais DD_REQUIRED to True
        Set Field_Option Field liga.EquiposMax DD_REQUIRED to True

      // --- Equipos lo mantiene el sistema (Update/Backout de equipo): no editable ---
        Set Field_Option Field liga.Equipos DD_NOENTER to True

        // --- El nombre no se puede cambiar una vez creado el registro ---
        Set Field_Option Field liga.Nombre DD_COMMIT to True

    End_Procedure

    // Los campos "committed" que forman parte de un indice pasan a ser de
    // solo lectura (por defecto seguirian dejando escribir para buscar)
    Function Field_CommitNoEnterOnIndex Integer iField Returns Boolean
        Function_Return True
    End_Function

End_Class